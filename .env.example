APP_NAME="PLASTICOS FENIX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ==============================================================================
# Motor nativo PostgreSQL para el sistema de RRHH.
# Asegurarse de tener habilitada la extensión pdo_pgsql en php.ini.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistemas_rrhh
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local

# ==============================================================================
# COLAS DE TRABAJO (Laravel Queues - Database Driver)
# ==============================================================================
# Requerido para el procesamiento asíncrono en segundo plano de boletas.
QUEUE_CONNECTION=database

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS - DISCO COMPARTIDO PARA BOLETAS
# ==============================================================================
# Ruta a la carpeta compartida privada en el servidor (NO accesible públicamente vía URL).
# Las boletas se almacenarán bajo la estructura: /boletas/{año}/{mes}/{dni_empleado}.pdf
BOLETAS_STORAGE_PATH=c:/xampp/htdocs/sistema-rrhh/storage/app/boletas_compartidas

# ==============================================================================
# ENVÍO DE CORREOS (SMTP Hosting cPanel)
# ==============================================================================
# Parámetros del servidor SMTP de cPanel para el envío automático de boletas.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.plasticosfenix.com
MAIL_PORT=465
MAIL_USERNAME=boletas@plasticosfenix.com
MAIL_PASSWORD=tu_contrasena_smtp_aqui
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="boletas@plasticosfenix.com"
MAIL_FROM_NAME="PLASTICOS FENIX - RRHH"

# Límite de envíos por minuto para cumplir restricciones de cPanel (Throttling)
MAIL_THROTTLE_PER_MINUTE=10
MAIL_THROTTLE_SECONDS=40

VITE_APP_NAME="${APP_NAME}"

